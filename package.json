{
  "name": "qbet",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:sim": "npm run ios:build && npm run ios:launch",
    "ios:build": "xcodebuild -workspace ios/qbet.xcworkspace -scheme qbet -configuration Debug -sdk iphonesimulator -destination 'platform=iOS Simulator,OS=18.6,name=iPhone 16 Pro' build",
    "ios:launch": "xcrun simctl install booted ~/Library/Developer/Xcode/DerivedData/qbet-hihpfwmvmztlysdzzqlwbaifmlqt/Build/Products/Debug-iphonesimulator/qbet.app && xcrun simctl launch booted com.rcdev714.qbet",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "web:export:prod": "expo export --platform web",
    "check:web:prod": "npm run typecheck && npm run lint && npm run web:export:prod",
    "verify": "npm run check:web:prod && npm run test && npm run test:beta-approval-email && npm run test:bet-contract-email",
    "health": "bash scripts/health-check.sh",
    "health:hooks": "npx tsx scripts/check-hooks-order.ts",
    "web:deploy:prod": "eas deploy --prod --environment production --export-dir dist",
    "deploy:web:prod": "bash ./scripts/deploy-web-production.sh",
    "lint": "expo lint",
    "policy:hashes": "npx tsx scripts/compute-policy-hashes.ts",
    "test": "npx tsx --test 'lib/**/*.test.ts' 'services/**/*.test.ts'",
    "test:sports-content": "npx tsx --test lib/compliance/sports-content.test.ts",
    "test:beta-approval-email": "deno test --no-config supabase/functions/_shared/beta-approval-email.test.ts",
    "test:bet-contract-email": "deno test --no-config supabase/functions/_shared/bet-contract-email.test.ts",
    "test:bet-contract-sql": "bash scripts/test-bet-contract-sql.sh",
    "test:integration": "npm run test:beta-approval-sql && npm run test:bet-contract-sql && npm run test:e2e:api",
    "test:e2e:env": "bash scripts/check-e2e-local-env.sh",
    "test:e2e:api": "npm run test:beta-approval-flow && bash scripts/test-bet-contract-flow.sh",
    "test:e2e": "bash scripts/run-local-e2e.sh",
    "test:e2e:ui": "playwright test",
    "test:beta-approval-sql": "bash scripts/test-beta-approval-sql.sh",
    "test:beta-approval-flow": "bash scripts/test-beta-approval-flow.sh",
    "predeploy:prod": "bash scripts/predeploy-prod.sh"
  },
  "dependencies": {
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@stripe/stripe-react-native": "^0.50.3",
    "@supabase/supabase-js": "^2.90.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.31",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-print": "^56.0.4",
    "expo-router": "~6.0.21",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "^56.0.18",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^26.3.1",
    "libphonenumber-js": "^1.13.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "~13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^56.0.15",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
