# Copy to supabase/functions/.env (gitignored if you add it to .gitignore)
# Loaded by: npx supabase functions serve ... --env-file supabase/functions/.env
#
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY automatically.

# Beta approval email (Resend) — required for send-beta-approval-email
RESEND_API_KEY=re_your_test_key
RESEND_FROM_EMAIL=Anymarkt <onboarding@anymarkt.com>
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Notification email + web push (dispatch-notification, send-welcome-email, send-group-invite-email)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@anymarkt.com
RESEND_WEBHOOK_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=

# Bet contract emails — same Resend secrets as beta approval
# Functions: send-bet-contract-email, dispatch-market-contract-emails

# ── Gemini feed suggestions (generate-feed-suggestions) ─────────────────────
# Get GEMINI_API_KEY: https://aistudio.google.com/apikey  (format: AIzaSy...)
# Generate CRON_INVOKER_SECRET: openssl rand -hex 32
#
# GEMINI_API_KEY=AIzaSyAbCdEfGhIjKlMnOpQrStUvWxYz1234567
# CRON_INVOKER_SECRET=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
# GEMINI_FEED_MODEL=gemini-2.5-flash
# AUTOPILOT_FEED_SUGGESTIONS_ENABLED=false
# AUTOPILOT_FEED_MAX_MARKETS_PER_RUN=1
# AUTOPILOT_FEED_MIN_SCORE=85
# AUTOPILOT_FEED_ALLOWED_CATEGORIES=Entertainment,Tech,Economy
#
# Production: same CRON_INVOKER_SECRET must also be stored in Supabase Vault as
# cron_invoker_secret (see docs/feed-suggestions-runbook.md).

# Gemini image gen (generate-image) — same GEMINI_API_KEY as above
# GEMINI_API_KEY=AIzaSy...

# Stripe / other functions (only if you use those locally)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from: stripe listen (payments) — see scripts/stripe-e2e-listen.sh
# STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_...  # from: stripe listen (identity) — separate CLI session
