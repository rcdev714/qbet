# Copy to supabase/functions/.env (gitignored if you add it to .gitignore)
# Loaded by: npx supabase functions serve ... --env-file supabase/functions/.env
#
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY automatically.

# Beta approval email (Resend) — required for send-beta-approval-email
RESEND_API_KEY=re_your_test_key
RESEND_FROM_EMAIL=AnyMarket <onboarding@camella.app>
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Stripe / other functions (only if you use those locally)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
