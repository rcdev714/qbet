# Copy to .env — client-safe variables only (embedded in client bundles).
#
# Expo (root) reads EXPO_PUBLIC_*.
# Vite (apps/web) reads VITE_* and also accepts EXPO_PUBLIC_* during cutover.
# Prefer setting both pairs to the same values, or only EXPO_PUBLIC_* for local dual-run.

EXPO_PUBLIC_ADMIN_EMAIL=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_anon_key
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_WEB_PUSH_PUBLIC_KEY=
EXPO_PUBLIC_LAUNCH_JURISDICTION=EC
EXPO_PUBLIC_BETA_REQUIRED=true
EXPO_PUBLIC_SENTRY_DSN=https://09d1ad9bc1e53d1b81d0a8f47758352a@o4511612891037696.ingest.us.sentry.io/4511612899229696

# Vite web (apps/web) — optional mirrors; fall back to EXPO_PUBLIC_* if unset
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_KEY=your_supabase_anon_key
# VITE_APP_URL=http://localhost:5173
# VITE_ADMIN_EMAIL=
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# VITE_LAUNCH_JURISDICTION=EC
# VITE_BETA_REQUIRED=true
# VITE_SENTRY_DSN=

# Beta access requests go to WhatsApp (see lib/contact.ts). Not env-configurable today.

# Copy server secrets to .env.local (gitignored). Required for /share/* server routes in local dev.
# SENTRY_AUTH_TOKEN=...  # from sentry.io — source map uploads only; never commit
# SERVICE_ROLE_KEY=your_supabase_service_role_key
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=Anymarkt <onboarding@anymarkt.com>
# WEB_PUSH_PUBLIC_KEY=...
# WEB_PUSH_PRIVATE_KEY=...
# WEB_PUSH_SUBJECT=mailto:support@anymarkt.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GEMINI_API_KEY=AIzaSy...                    # https://aistudio.google.com/apikey

# Feed suggestion cron (generate-feed-suggestions edge function)
# CRON_INVOKER_SECRET=...                     # openssl rand -hex 32 — see docs/feed-suggestions-runbook.md
# GEMINI_FEED_MODEL=gemini-2.5-flash
# AUTOPILOT_FEED_SUGGESTIONS_ENABLED=false    # edge secret only; keep false until reviewed
